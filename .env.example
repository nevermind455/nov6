# Native C++20 baseline. Paper is the default; no wallet is needed.
SNIPER_ONLY=1
SNIPER_LIVE_CANARY=0
SNIPER_PRIMARY_FEED=coinbase
SNIPER_COINBASE_CONNS=2
SNIPER_K_BP=0.5
SNIPER_WINDOW_MS=250
SNIPER_COOLDOWN_MS=300
SNIPER_MIN_LEFT_S=10
SNIPER_STALE_MS=2000
SNIPER_MAX_FILLS_ROUND=20
SNIPER_MAX_SIDE_SHARES=200
MIN_BUY_PRICE=0.05
MAX_BUY_PRICE=0.95
TRADE_LAST_SECONDS=300
MIN_SECONDS_TO_EXPIRY=10
SNIPER_ORDER_TYPE=FAK
SNIPER_ORDER_SIZING=shares
SNIPER_SHARES=10
SNIPER_SLIP=0.02
SNIPER_FAIR=1
SNIPER_FAIR_MARGIN=0.01
SNIPER_FAIR_VOL_S=300
SNIPER_KELLY=1
SNIPER_KELLY_FRACTION=0.25
SNIPER_HYBRID_SIZING=1
SNIPER_HYBRID_VOL_BASELINE_BP=1.0
SNIPER_HYBRID_DRAWDOWN_STOP=0.20
SNIPER_HYBRID_DRAWDOWN_PAUSE_S=600
SNIPER_KELLY_MIN_ENTRY=0
SNIPER_VENUE_MIN_SHARES=0
SNIPER_PTB_SKIP_CLOSE=0
SNIPER_CANARY_MAX_SHARES=25
SNIPER_CANARY_MAX_ORDERS=40
SNIPER_CANARY_MAX_FILLS=20
SNIPER_CANARY_MAX_ROUNDS=12
SNIPER_CANARY_MAX_SPEND_USD=60
SNIPER_CANARY_MAX_LOSS_USD=20
# 1: a reached budget stays reached until a deliberate --new-canary-session.
# 0: the reference's way, which raises it by its original size after each pause.
SNIPER_CANARY_HARD_STOP=1
PAPER_START_BALANCE=1000
# Independent paper model; no historical live calibration is bundled.
SNIPER_DELAY_SOURCE=model
SNIPER_FILL_ODDS=off
SNIPER_PAPER_CASH_FROM=off
SNIPER_PAPER_LIVE_PARITY=0
SNIPER_HOLD_MS=250
SNIPER_PAPER_EXTRA_MS=200
SNIPER_BOOK_WAIT_MS=500
SETTLE_ONCHAIN=1
# Keep wallet keys and API credentials out of this file. Export them only
# into the process environment if deliberately using --live.
